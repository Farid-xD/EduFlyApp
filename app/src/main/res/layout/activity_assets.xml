<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_background">

    <!-- App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/dark_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Back Button (btnBack) -->
        <ImageView
            android:id="@+id/backButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            app:tint="@color/white" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back"
            android:background="@android:color/transparent"
            android:textColor="@color/white" />

        <!-- Or if you want to keep the ImageView but also have a Button -->

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/assets_title"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Add Asset Button (btnAddAsset) -->

        <!-- Refresh Button (btnRefresh) -->

        <!-- Logout Button (btnLogout) -->
        <Button
            android:id="@+id/btnAddAsset"
            android:layout_width="73dp"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:text="Add"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:text="@string/refresh"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="logout"
            android:background="@android:color/transparent"
            android:textColor="@color/white" />

        <ImageView
            android:id="@+id/searchIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_search"
            android:contentDescription="@string/search"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp"
        android:gravity="center_vertical"
        >

        <EditText
            android:id="@+id/searchEditText"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="@string/search_courses"
            android:textColorHint="@color/text_tertiary"
            android:textColor="@color/white"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/searchButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:text="@string/search"
            style="@style/Widget.MaterialComponents.Button"
            app:backgroundTint="@color/purple"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <!-- Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:background="@color/dark_background">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- All Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/allChip"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:checkable="true"
                android:checked="true"
                app:chipBackgroundColor="@color/primary"
                app:chipStrokeColor="@color/purple"
                app:chipStrokeWidth="1dp"
                app:checkedIconVisible="false"
                app:chipSurfaceColor="@color/selector_chip_background"
                android:layout_marginEnd="8dp" />

            <!-- Documents Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/documentsChip"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Documents"
                android:checkable="true"
                app:chipBackgroundColor="@color/primary"
                app:chipStrokeColor="@color/purple"
                app:chipStrokeWidth="1dp"
                app:checkedIconVisible="false"
                app:chipSurfaceColor="@color/selector_chip_background"
                android:layout_marginEnd="8dp" />

            <!-- Images Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/imagesChip"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Images"
                android:checkable="true"
                app:chipBackgroundColor="@color/primary"
                app:chipStrokeColor="@color/purple"
                app:chipStrokeWidth="1dp"
                app:checkedIconVisible="false"
                app:chipSurfaceColor="@color/selector_chip_background"
                android:layout_marginEnd="8dp" />

            <!-- Videos Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/videosChip"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Videos"
                android:checkable="true"
                app:chipBackgroundColor="@color/primary"
                app:chipStrokeColor="@color/purple"
                app:chipStrokeWidth="1dp"
                app:checkedIconVisible="false"
                app:chipSurfaceColor="@color/selector_chip_background"
                android:layout_marginEnd="8dp" />

            <!-- Audio Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/audioChip"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Audio"
                android:checkable="true"
                app:chipBackgroundColor="@color/primary"
                app:chipStrokeColor="@color/purple"
                app:chipStrokeWidth="1dp"
                app:checkedIconVisible="false"
                app:chipSurfaceColor="@color/selector_chip_background" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Assets Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/assetsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:visibility="visible"
            tools:listitem="@layout/item_asset" />

        <!-- Loading Indicator -->
        <LinearLayout
            android:id="@+id/loadingLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- ProgressBar (progressBar) -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/loading"
                android:textColor="@color/gray_700"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/emptyLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <!-- Empty State TextView (emptyState) -->
            <TextView
                android:id="@+id/emptyState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_assets"
                android:textColor="@color/gray_700"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_folder"
                android:contentDescription="@string/no_assets"
                app:tint="@color/gray_400" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/no_assets"
                android:textColor="@color/gray_700"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/no_assets_message"
                android:textColor="@color/gray_500"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/uploadButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/upload_asset"
                style="@style/Widget.MaterialComponents.Button"
                app:backgroundTint="@color/purple"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- Error State -->
        <LinearLayout
            android:id="@+id/errorLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_error"
                android:contentDescription="@string/error"
                app:tint="@color/error_color" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/error"
                android:textColor="@color/gray_700"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/errorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/error_loading_courses"
                android:textColor="@color/gray_500"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/retry"
                style="@style/Widget.MaterialComponents.Button"
                app:backgroundTint="@color/purple"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="horizontal">

        <!-- Dashboard -->
        <LinearLayout
            android:id="@+id/dashboardTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@color/dark_background">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_dashboard"
                app:tint="@color/gray_500" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/dashboard_tab"
                android:textColor="@color/gray_500"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Courses -->
        <LinearLayout
            android:id="@+id/coursesTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@color/dark_background">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_courses"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/courses_tab"
                android:textColor="@color/gray_500"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Assets (Active) -->
        <LinearLayout
            android:id="@+id/assetsTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@color/dark_background">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_assets"
                app:tint="@color/purple" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/assets_tab"
                android:textColor="@color/purple"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Profile -->
        <LinearLayout
            android:id="@+id/profileTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@color/dark_background">

            <ImageView
                android:id="@+id/profileImageView"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_profile"
                android:background="@drawable/circle_background"
                android:padding="2dp"
                app:tint="@color/gray_500"
                tools:ignore="MissingClass" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/profile_tab"
                android:textColor="@color/gray_500"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>