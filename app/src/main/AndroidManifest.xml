<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet permission for API calls -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Network state permission for checking connectivity -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Storage permissions - Android 13+ -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Storage permissions - Android 12 and below -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Optional: For notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/app_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/app_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Proj"
        tools:targetApi="31"
        android:usesCleartextTraffic="false">

        <!-- Login Activity (LAUNCHER) -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.Proj"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Register Activity -->
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.Proj"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- Main Dashboard Activity -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.Proj"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />

        <!-- Courses Activity -->
        <activity
            android:name=".activities.CoursesActivity"
            android:exported="false"
            android:theme="@style/Theme.Proj"
            android:screenOrientation="portrait" />

        <!-- Assets Activity -->
        <activity
            android:name=".activities.AssetsActivity"
            android:exported="false"
            android:theme="@style/Theme.Proj"
            android:screenOrientation="portrait" />

        <!-- Course Detail Activity -->
        <activity
            android:name=".activities.CourseDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Proj"
            android:screenOrientation="portrait"
            android:parentActivityName=".activities.CoursesActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activities.CoursesActivity" />
        </activity>

        <!-- QuickCreate Activity -->
        <activity
            android:name=".activities.QuickCreateActivity"
            android:exported="false"
            android:theme="@style/Theme.Proj"
            android:screenOrientation="portrait"
            android:parentActivityName=".activities.MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activities.MainActivity" />
        </activity>

        <!-- YouTube Player Activity -->
        <activity
            android:name=".activities.YouTubePlayerActivity"
            android:exported="false"
            android:theme="@style/Theme.Proj"
            android:screenOrientation="portrait"
            android:parentActivityName=".activities.CourseDetailActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".activities.CourseDetailActivity" />
        </activity>

        <!-- FileProvider for camera/sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_path" />
        </provider>

    </application>
</manifest>